{
  "Program skeleton": {
    "prefix": "program",
    "description": "Complete Caramel program: quantization preamble + a flow",
    "body": [
      "# ${1:description}",
      "crml::quantmax=${2:1000};",
      "crml::quantmin=${3:-1000};",
      "crml::quantres=${4:0};",
      "",
      "calc::lambda_flow ${5:my_flow}(${6:a, b}) {",
      "\t${7:a b matmul product =}",
      "} return ${8:product};",
      ""
    ]
  },
  "Quantization preamble": {
    "prefix": "crml",
    "description": "Required crml:: quantization directives",
    "body": [
      "crml::quantmax=${1:1000};",
      "crml::quantmin=${2:-1000};",
      "crml::quantres=${3:0};"
    ]
  },
  "lambda_flow": {
    "prefix": "flow",
    "description": "Named flow with parameters and a return clause",
    "body": [
      "calc::lambda_flow ${1:name}(${2:params}) {",
      "\t$0",
      "} return ${3:result};"
    ]
  },
  "lambda_symphony": {
    "prefix": "symphony",
    "description": "Higher-level computation grouping (parser-level)",
    "body": [
      "calc::lambda_symphony ${1:name}(${2:params}) {",
      "\t$0",
      "} return ${3:result};"
    ]
  },
  "lambda_calculator": {
    "prefix": "calculator",
    "description": "Calculator body with a channel count (parser-level)",
    "body": [
      "calc::lambda_calculator(channels=${1:4}) ${2:name}(${3:params}) {",
      "\t$0",
      "} return ${4:result};"
    ]
  },
  "Script input": {
    "prefix": "in",
    "description": "in::name = <literal>; - fills a flow parameter without --in",
    "body": ["in::${1:name} = ${2:[[1,2],[3,4]]};"]
  },
  "Matrix profile": {
    "prefix": "profile",
    "description": "profile::name; - print the algebraic profile of an input matrix",
    "body": ["profile::${1:name};"]
  },
  "Worker status": {
    "prefix": "status",
    "description": "status::alias; - print a declared worker's status metadata",
    "body": ["status::${1:alias};"]
  },
  "Linear layer": {
    "prefix": "layer",
    "description": "matmul + bias + relu, the canonical dense layer",
    "body": [
      "${1:x} ${2:w} matmul ${3:product} =",
      "${3:product} ${4:bias} elemwise_add ${5:shifted} =",
      "${5:shifted} relu ${6:activated} ="
    ]
  },
  "RPN assignment": {
    "prefix": "rpn",
    "description": "operand operand op result = ",
    "body": ["${1:a} ${2:b} ${3|add,sub,mul,div,matmul,elemwise_add,elemwise_sub,elemwise_mul,elemwise_div,scalar_mul|} ${4:result} ="]
  },
  "Clock section": {
    "prefix": "clock",
    "description": "@clock(n): - mark a computation phase",
    "body": ["@clock(${1:1}):"]
  },
  "Tile decorator": {
    "prefix": "tile",
    "description": "@tile {rows: R, cols: C}",
    "body": ["@tile {rows: ${1:2}, cols: ${2:2}}"]
  },
  "Autodiff decorator": {
    "prefix": "autodiff",
    "description": "@autodiff on a flow",
    "body": ["@autodiff"]
  },
  "Quantize decorator": {
    "prefix": "quantize",
    "description": "@quantize {...} on a statement",
    "body": ["@quantize {bits: ${1:8}}"]
  },
  "Device block": {
    "prefix": "device",
    "description": "crml::device::fpga { ... } device declaration",
    "body": [
      "crml::device::${1|fpga,cpu|} {",
      "\t$0",
      "}"
    ]
  },
  "Memory write": {
    "prefix": "memwrite",
    "description": "value memory::write",
    "body": ["${1:value} memory::write"]
  },
  "Print": {
    "prefix": "print",
    "description": "return(value); - print statement",
    "body": ["return(${1:value});"]
  },
  "zeros": {
    "prefix": "zeros",
    "description": "R C zeros - all-zero matrix",
    "body": ["${1:3} ${2:3} zeros"]
  },
  "ones": {
    "prefix": "ones",
    "description": "R C ones - all-ones matrix",
    "body": ["${1:3} ${2:3} ones"]
  },
  "full": {
    "prefix": "full",
    "description": "R C V full - matrix filled with V",
    "body": ["${1:2} ${2:2} ${3:7} full"]
  },
  "eye": {
    "prefix": "eye",
    "description": "N eye - identity matrix",
    "body": ["${1:4} eye"]
  },
  "diag": {
    "prefix": "diag",
    "description": "[a,b,c] diag - diagonal matrix",
    "body": ["[${1:2,3,5}] diag"]
  },
  "range": {
    "prefix": "range",
    "description": "N range - vector [0..N-1]",
    "body": ["${1:6} range"]
  },
  "band": {
    "prefix": "band",
    "description": "N LOWER UPPER FILL band - banded matrix",
    "body": ["${1:8} ${2:1} ${3:0} ${4:1} band"]
  },
  "tridiag": {
    "prefix": "tridiag",
    "description": "N SUB DIAG SUPER tridiag - tridiagonal matrix",
    "body": ["${1:5} ${2:1} ${3:2} ${4:1} tridiag"]
  },
  "from_spectrum": {
    "prefix": "from_spectrum",
    "description": "[l1,l2,...] from_spectrum - matrix with the given spectrum",
    "body": ["[${1:2,3,5,7}] from_spectrum"]
  },
  "random": {
    "prefix": "random",
    "description": "R C random - reproducible pseudo-random matrix",
    "body": ["${1:3} ${2:3} random"]
  },
  "Lambda": {
    "prefix": "lambda",
    "description": "lambda x => body end",
    "body": ["lambda ${1:x} => ${2:x} end"]
  }
}
